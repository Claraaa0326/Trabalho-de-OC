#include <math.h>


int bcdParaInt(int *v, int n) { // funçao que converte bcd para binario 
    int valor = 0;
    int numdigitos = n/4;

    
    for (int d = 0; d < n/4; d++) { // converte o numero como se fosse sem sinal
       int digito = v[4*d]*8 + v[4*d+1]*4 + v[4*d+2]*2 + v[4*d+3];
       valor = valor * 10 + digito;
    }
     return valor;
}

   void intParabcd (int valor, int *v, int n) { 
    int numDigitos = n/4;
      
      for ( int d= numDigitos - 1; d>= 0; d--) {
        int digito = valor % 10;
        valor = valor / 10;
        v[4*d]   = (digito >> 3) & 1;
        v[4*d+1] = (digito >> 2) & 1;
        v[4*d+2] = (digito >> 1) & 1;
        v[4*d+3] = digito & 1;


      }
   }



