#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    int A[n], B[n], C[n+1];  // Vetores A e B, resultado C de n+1 bits
    int carry = 0;
    printf("Digite o tamanho n dos vetores binarios: ");
    scanf("%d", &n);

    // Leitura dos bits de A
    printf("Digite os %d bits de A:", n);
    for (i = 0; i < n; i++) {
        scanf("%d", A[i]);
    }

    // Leitura dos bits de B
    printf("Digite os %d bits de B", n);
    for (i = 0; i < n; i++) {
        scanf("%d", B[i]);
    }

    // Soma bit a bit (da direita para a esquerda)
    for (i = n-1; i >= 0; i--) { //soma começa pelo LSB
        int soma = A[i] + B[i] + carry;
        C[i+1] = soma % 2;   // bit resultante (garante que o bit resultante seja sempre 0 ou 1
        carry = soma / 2;    // transporte (carry)
    }
    C[0] = carry;  // garante que o carry seja colocado na posiçao mais á esquerda

    // Impressão do resultado
    printf("Resultado da soma em binario: ");
    for (i = 0; i < n+1; i++) {
        printf("%d", C[i]);
    }
    printf("\n");

    return 0;
}

