#include <stdio.h>
#include <stdlib.h>

int binparaint(int *V, int bits) {
    int num = 0; //converte de binário para inteiro//

    if (V[0] == 1) { //se for negativo (bit mais significativo = 1)//
        // complemento de 2 = inverte bits e soma 1//
 int *temp = malloc(bits * sizeof(int));
for (int i = 0; i < bits; i++)
temp[i] = 1 - V[i];
 int carry = 1;
  for (int i = bits - 1; i >= 0; i--) { // reduz de 1 em 1//
   int s = temp[i] + carry;
  temp[i] = s % 2;
  carry = s / 2;   // <-- corrigido
        }
 for (int i = 0; i < bits; i++)
    num = (num << 1) | temp[i];
free(temp);
 return -num;
 }
 // número positivo//
 for (int i = 0; i < bits; i++)
 num = (num << 1) | V[i];
 return num;
}
//Converte de inteiro para binário (complemento de 2) //.
void intparabin(int n, int *V, int bits) {
  unsigned int val;
 if (n < 0)
   val = (1u << bits) + n; // complemento de 2//
else
  val = n;
for (int i = bits - 1; i >= 0; i--) {
        V[i] = val & 1;
        val >>= 1;
 }
}
// Converte de binário  4n para hexadecimal//.
void printHex(int *V, int bits) {
int hex = bits / 4;   // <-- corrigido
rintf("0x");
 for (int i = 0; i < hex; i++) {
        int val = 0;
  for (int j = 0; j < 4; j++)
            val = (val << 1) | V[i * 4 + j];
 if (val < 10) printf("%d", val);
else printf("%c", 'A' + (val - 10));
    }

 printf("\n");
}
// Soma de vetores binários (detecção de overflow)//.
int soma(int *A, int *B, int *C, int bits) {
    int carry = 0;
    for (int i = bits - 1; i >= 0; i--) {
        int s = A[i] + B[i] + carry;
        C[i] = s & 1;
        carry = s >> 1;
    }

    // Overflow( regra de sinais) em complemento de 2:
    if (A[0] == B[0] && C[0] != A[0])
        return 0; // overflow

    return 1; // deu certo.//
}

int main() {
    int n;
    printf("Digite n (bits do numero hexadecimal): ");
    scanf("%d", &n);
int bits = 4 * n;
int *A = malloc(bits * sizeof(int));
 int *B = malloc(bits * sizeof(int));
 int *C = malloc(bits * sizeof(int));
 printf("Digite A (%d bits):\n", bits);
for (int i = 0; i < bits; i++) scanf("%d", &A[i]);
printf("Digite B (%d bits):\n", bits);
for (int i = 0; i < bits; i++) scanf("%d", &B[i]);
 if (!soma(A, B, C, bits)) {
   printf("ERRO: Overflow na soma!\n");
  return 0;
 }
 printf("Resultado em hexadecimal: ");
printHex(C, bits);

 free(A);
 free(B);
 free(C);

    return 0;
}
