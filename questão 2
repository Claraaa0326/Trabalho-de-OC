#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    printf("Digite o tamanho n dos vetores binarios: ");
    scanf("%d", &n);

    int A[n], B[n], C[n];
    int borrow = 0;

    // Leitura de A com validação
    printf("Digite os %d bits de A (0 ou 1): ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &A[i]);
        if (A[i] != 0 && A[i] != 1) {
            printf("Número inválido! Digite apenas 0 ou 1.\n");
            i--; // voltar a casa e repetir a leitura
        }
    }

    // Leitura de B com validação
    printf("Digite os %d bits de B (0 ou 1): ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &B[i]);
        if (B[i] != 0 && B[i] != 1) {
            printf("Entrada invalida! Digite apenas 0 ou 1.\n");
            i--; //voltar a casa e repetir a leitura
        }
    }

    // Verificação se A < B 
    int menor = 0; //variavel de controle para saber se A é menor ou não 
    for (i = 0; i < n; i++) {
        if (A[i] < B[i]) {
            menor = 1;
            break;
        } else if (A[i] > B[i]) {
            break;
        }
    }
    if (menor) {
        printf("Erro: a subtracao nao e possivel pois A < B.\n");
        return 1;
    }

    // Subtração  (da direita para a esquerda)
    for (i = n-1; i >= 0; i--) {
        int sub = A[i] - B[i] - borrow; //vai um
        if (sub < 0) {
            C[i] = sub + 2;  // ajusta o bit com empréstimo
            borrow = 1;      // marca que houve empréstimo
        } else {
            C[i] = sub;
            borrow = 0;
        }
    }

    // mostrar o resultado
    printf("Resultado da subtracao em binario: ");
    for (i = 0; i < n; i++) {
        printf("%d", C[i]);
    }
    printf("\n");

    return 0;
}
