#include <stdio.h>
#include <stdlib.h>
#include <math.h>


int complementoParaInt(int *v, int n) {
    int valor = 0;


    for (int i = 0; i < n; i++) { // converte o numero como se fosse sem sinal
        valor = (valor << 1) | v[i];
    }

    if (v[0] == 1) { // se o MSB for 1, o numero e negativo
        valor -= (1 << n);  // justa para complemento de 2
    }

    return valor;
}

// Converte inteiro para vetor binário (complemento de 2)
void intParaComplemento(long long valor, int *v, int n) {
    unsigned long long mask = ((unsigned long long)1 << n) - 1; // máscara para n bits
    unsigned long long bin = valor & mask; // variavel auxiliar que contem os bits menos significativos
    for (int i = n - 1; i >= 0; i--) {
        v[i] = bin & 1;
        bin >>= 1;
    }
}

int main() {
    int n = 8; // número de bits
    int A[8], B[8];
    int C[8];
    int R[8]; // resto

    printf("Digite os %d bits do primeiro número:\n", n); // com espaço entre os numeros
    for (int i = 0; i < n; i++) scanf("%d", &A[i]);

    printf("Digite os %d bits do segundo número:\n", n); // com espaço entre os numeros
    for (int i = 0; i < n; i++) scanf("%d", &B[i]);

    int a = complementoParaInt(A, n);
    int b = complementoParaInt(B, n);

    if (b == 0) {
        printf("erro! divisao por 0\n");
        return 1;
    }

 int quociente = a / b;
 int resto = a % b;

   intParaComplemento(quociente, C, n); //converte o resultado para binario
   intParaComplemento(resto, R, n);

    printf("Resultado da divisao: %d\n", quociente);
    printf("Representação binária do quociente (%d bits): ",n);
    for (int i = 0; i < n; i++) {
        printf("%d", C[i]);
    }
    printf("\n");

    printf("Resto da divisao: %d\n", resto);
    printf("Representacao binaria do resto (%d bits): ", n);
    for (int i = 0; i < n; i++) {
        printf("%d", R[i]);
    }
    printf("\n");


    return 0;
}

